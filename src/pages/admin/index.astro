---
// Admin page for the featured stories (Sveltia CMS). It runs entirely in the browser and saves
// the Markdown files to GitHub. Its settings are in public/admin/config.yml (loaded as ./config.yml).
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>RAPID Growth R10 admin</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	</head>
	<body>
		<script is:inline src="https://unpkg.com/@sveltia/cms@0.238.1/dist/sveltia-cms.js"></script>
		<!-- Markdown renderer for the preview (same version as the website) and the story preview + save cleanup -->
		<script is:inline src="https://cdn.jsdelivr.net/npm/marked@18.1.2/lib/marked.umd.js"></script>
		<script is:inline src="/admin/preview.js"></script>
	</body>
</html>
