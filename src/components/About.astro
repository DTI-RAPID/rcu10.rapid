---
import { getImage } from 'astro:assets';
import { about } from '../data/rapid';
import { getStories, storyHref } from '../lib/stories';
import StackedGallery, { type DeckItem } from './StackedGallery';

// Stacked deck: the 6 newest featured stories by date, each with its main photo, linked to its story.
// It updates on its own when stories are added or edited in the admin.
const newest = (await getStories())
	.slice()
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.slice(0, 6);
const items: DeckItem[] = await Promise.all(
	newest.map(async (story) => {
		const img = await getImage({ src: story.data.image, width: 800, format: 'webp' });
		return { src: img.src, alt: story.data.alt || story.data.title, title: story.data.title, href: storyHref(story) };
	}),
);
---

<section id="about" class="about relative bg-mist py-24 sm:py-36">
	<div class="shell grid items-center gap-16 lg:grid-cols-[1.05fr_1fr] lg:gap-24">
		<div>
			<p class="text-xl text-teal">Introducing the</p>
			<h2 class="display mt-1 text-[clamp(2.6rem,6.5vw,5.25rem)] text-teal">RAPID Growth Project</h2>
			<div class="mt-10 max-w-[36rem] space-y-5 text-lg text-ink/85">
				{about.paragraphs.map((p) => <p>{p}</p>)}
			</div>
			<a
				href={about.learnMore}
				target="_blank"
				rel="noopener"
				class="mt-9 inline-block font-semibold text-teal underline decoration-leaf decoration-2 underline-offset-[6px] hover:decoration-teal"
			>
				Learn more about the project on dtirapid.ph
			</a>
		</div>

		<StackedGallery client:visible items={items} />
	</div>
</section>

<style is:global>
	/* the fanned-out cards must never widen the page on phones */
	.about {
		overflow-x: clip;
	}

	/* Stacked photo deck (StackedGallery.tsx) */
	.deck {
		width: 100%;
		max-width: 26rem;
		margin-inline: auto;
		outline: none;
	}
	.deck-stage {
		position: relative;
		aspect-ratio: 3 / 4;
		margin-right: 3.5rem; /* room for the cards fanned out behind */
		touch-action: pan-y;
		user-select: none;
		cursor: grab;
	}
	.deck-stage:active {
		cursor: grabbing;
	}
	.deck-card {
		position: absolute;
		inset: 0;
		overflow: hidden;
		border-radius: 10px;
		background: var(--color-mist-deep);
		box-shadow: 0 30px 50px -28px rgb(3 26 29 / 0.6);
		transform-origin: 50% 90%;
		/* springy settle with a small overshoot */
		/* smooth settle with only a hint of bounce */
		transition:
			transform 0.65s cubic-bezier(0.22, 1.12, 0.36, 1),
			filter 0.5s ease,
			opacity 0.45s ease;
		will-change: transform;
	}
	.deck-card img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
	}
	.deck-caption {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 2.75rem;
		margin-right: 3.5rem;
	}
	.deck-title {
		flex: 1 1 12rem;
		/* always reserve two lines so the page never shifts when the title changes */
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		min-height: calc(2 * 1.5em);
		line-height: 1.5;
		font-weight: 600;
		color: var(--color-teal);
		animation: deck-in 0.5s var(--ease-out-quint);
	}
	.deck-nav {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex: none;
	}
	.deck-nav button {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 6px;
		border: 1px solid rgb(0 68 80 / 0.25);
		color: var(--color-teal);
		transition:
			background-color 0.2s,
			color 0.2s;
	}
	.deck-nav button:hover {
		background: var(--color-teal);
		color: var(--color-mist);
	}
	.deck-count {
		min-width: 4.2rem;
		text-align: center;
		font-variant-numeric: tabular-nums;
		font-size: 0.95rem;
		color: rgb(14 35 38 / 0.55);
	}
	.deck-count-now {
		display: inline-block;
		font-weight: 700;
		color: var(--color-teal);
		animation: deck-in 0.45s var(--ease-out-quint);
	}
	@keyframes deck-in {
		from {
			opacity: 0;
			transform: translateY(0.5rem);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.deck-card {
			transition: none;
		}
		.deck-title,
		.deck-count-now {
			animation: none;
		}
	}
</style>
