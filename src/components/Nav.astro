---
import { Image } from 'astro:assets';
import rapidLogo from '../assets/logos/rapid.svg';
import { about } from '../data/rapid';

const links = [
	{ label: 'About', href: '/#about' },
	{ label: 'Impact', href: '/#impact' },
	{ label: 'Where we work', href: '/#where-we-work' },
	{ label: 'Featured', href: '/#featured' },
	{ label: 'News', href: '/#news' },
];
---

<header class="nav-wrap" data-nav>
	<nav class="nav shell" aria-label="Main">
		<a href="/#top" class="flex items-center gap-3 rounded-full" aria-label="RAPID Growth Project, Region 10, back to top">
			<Image src={rapidLogo} alt="" class="h-9 w-auto" loading="eager" />
			<span class="hidden whitespace-nowrap text-sm leading-tight text-teal sm:block">
				<span class="block font-semibold">Region 10</span>
				<span class="block text-teal/70">Northern Mindanao</span>
			</span>
		</a>

		<!-- Laptop and wider: links in the bar -->
		<ul class="hidden items-center gap-7 whitespace-nowrap text-[0.95rem] font-medium text-ink/80 lg:flex">
			{links.map((l) => <li><a href={l.href} class="transition-colors hover:text-teal">{l.label}</a></li>)}
		</ul>

		<div class="flex items-center gap-2">
			<a href={about.learnMore} target="_blank" rel="noopener" class="btn hidden whitespace-nowrap bg-teal py-2.5 text-sm text-mist hover:bg-canopy sm:inline-flex">
				Visit dtirapid.ph
			</a>
			<!-- Phones and tablets: menu button -->
			<button
				type="button"
				class="menu-btn lg:hidden"
				aria-label="Open menu"
				aria-expanded="false"
				aria-controls="mobile-menu"
				data-menu-btn
			>
				<span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
			</button>
		</div>
	</nav>

	<div id="mobile-menu" class="menu-panel shell lg:hidden" data-menu hidden>
		<ul>
			{
				links.map((l) => (
					<li>
						<a href={l.href} data-menu-link>
							{l.label}
						</a>
					</li>
				))
			}
		</ul>
		<a href={about.learnMore} target="_blank" rel="noopener" class="btn mt-4 w-full justify-center bg-teal text-mist hover:bg-canopy">
			Visit dtirapid.ph
		</a>
	</div>
</header>

<style>
	.nav-wrap {
		position: fixed;
		inset: 0.75rem 0 auto;
		z-index: 50;
		pointer-events: none;
	}
	.nav,
	.menu-panel {
		pointer-events: auto;
		width: calc(100% - 2rem);
		max-width: 76rem;
		background: color-mix(in oklab, var(--color-mist) 88%, transparent);
		backdrop-filter: blur(14px) saturate(1.3);
		-webkit-backdrop-filter: blur(14px) saturate(1.3);
		box-shadow:
			0 0 0 1px color-mix(in oklab, var(--color-teal) 10%, transparent),
			0 10px 30px -12px rgb(3 26 29 / 0.45);
	}
	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 0.5rem;
		padding-inline: 0.75rem 0.5rem;
		border-radius: 999px;
	}

	/* Menu button: three lines that turn into an X when open */
	.menu-btn {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		background: var(--color-teal);
		color: var(--color-mist);
	}
	/* laptop and wider use the link row instead (this rule must win over display: grid above) */
	@media (min-width: 1024px) {
		.menu-btn,
		.menu-panel {
			display: none !important;
		}
	}
	.menu-icon {
		position: relative;
		width: 1.15rem;
		height: 0.85rem;
	}
	.menu-icon span {
		position: absolute;
		left: 0;
		width: 100%;
		height: 2px;
		border-radius: 2px;
		background: currentColor;
		transition:
			transform 0.3s var(--ease-out-quint),
			opacity 0.2s;
	}
	.menu-icon span:nth-child(1) {
		top: 0;
	}
	.menu-icon span:nth-child(2) {
		top: calc(50% - 1px);
	}
	.menu-icon span:nth-child(3) {
		bottom: 0;
	}
	.menu-btn[aria-expanded='true'] .menu-icon span:nth-child(1) {
		transform: translateY(calc(0.425rem - 1px)) rotate(45deg);
	}
	.menu-btn[aria-expanded='true'] .menu-icon span:nth-child(2) {
		opacity: 0;
	}
	.menu-btn[aria-expanded='true'] .menu-icon span:nth-child(3) {
		transform: translateY(calc(-0.425rem + 1px)) rotate(-45deg);
	}

	/* Dropdown panel under the bar */
	.menu-panel {
		/* solid, so page content never shows through the open menu */
		background: var(--color-mist);
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
		margin-top: 0.6rem;
		padding: 0.75rem;
		border-radius: 1.5rem;
		animation: menu-in 0.3s var(--ease-out-quint);
	}
	.menu-panel[hidden] {
		display: none;
	}
	.menu-panel li + li {
		border-top: 1px solid rgb(0 68 80 / 0.1);
	}
	.menu-panel ul a {
		display: block;
		padding: 0.95rem 0.75rem;
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--color-teal);
		border-radius: 0.75rem;
	}
	.menu-panel ul a:hover {
		background: rgb(0 68 80 / 0.06);
	}
	@keyframes menu-in {
		from {
			opacity: 0;
			transform: translateY(-0.5rem);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.menu-panel,
		.menu-icon span {
			animation: none;
			transition: none;
		}
	}
</style>

<script>
	// Phone/tablet menu: open with the button; close on a link, Esc, or a tap outside
	const wrap = document.querySelector<HTMLElement>('[data-nav]');
	const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
	const panel = document.querySelector<HTMLElement>('[data-menu]');

	const setOpen = (open: boolean) => {
		if (!btn || !panel) return;
		panel.hidden = !open;
		btn.setAttribute('aria-expanded', String(open));
		btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
	};

	btn?.addEventListener('click', () => setOpen(panel?.hidden ?? false));
	panel?.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && panel && !panel.hidden) {
			setOpen(false);
			btn?.focus();
		}
	});
	document.addEventListener('click', (e) => {
		if (panel && !panel.hidden && wrap && !wrap.contains(e.target as Node)) setOpen(false);
	});
	// Close it if the screen grows to laptop width while open
	window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>
