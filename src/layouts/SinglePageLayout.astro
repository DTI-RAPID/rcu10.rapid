---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { storyHref, formatDate, type Story } from "../lib/stories";
import { renderStoryBlocks, photoSlots } from "../lib/storyBody";

interface Props {
  story: Story;
  others: Story[];
}

const { story, others } = Astro.props;
const {
  title,
  tag,
  youth,
  date,
  place,
  summary,
  image,
  alt,
  image2,
  alt2,
  author,
  unit,
  source,
  photos,
} = story.data;
const published = formatDate(date);

// Story text, cleaned of pasted Word/Docs artefacts, split into blocks
const blocks = renderStoryBlocks(story.body ?? "");
// Extra photos (max 4): the `photos` list, or the older single "second photo"
const extra = (photos?.length ? photos : image2 ? [{ image: image2, size: "medium" as const }] : []).slice(0, 4);
const slots = photoSlots(blocks, extra.length);
// photos to show after each block, alternating left / right
const after = new Map<number, { image: typeof image; size: string; side: "left" | "right"; n: number }[]>();
extra.forEach((ph, k) => {
  const list = after.get(slots[k]) ?? [];
  list.push({ image: ph.image, size: ph.size, side: k % 2 === 0 ? "left" : "right", n: k + 2 });
  after.set(slots[k], list);
});
const photoAlt = (n: number) => (n === 2 && alt2 ? alt2 : `Photo ${n} from the story: ${title}`);
---

<Layout title={`${title} | RAPID Growth Region 10`} description={summary}>
	<Nav />
	<main>
		<header class="story-head text-mist">
			<div class="story-wrap grid items-center gap-10 pb-14 pt-24 sm:pt-32 lg:grid-cols-[1.1fr_1fr] lg:gap-14 lg:pb-16">
				<div>
					<div class="flex flex-wrap items-center justify-between gap-3">
						<a href="/#featured" class="back inline-flex items-center gap-2 text-sm font-semibold text-mist/75 hover:text-mist">
							<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
								<path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2"></path>
							</svg>
							Featured stories
						</a>
						<div class="flex gap-2 lg:hidden">
							{youth && <span class="tag tag-youth">Youth</span>}
							<span class={`tag tag-${tag.toLowerCase()}`}>{tag}</span>
						</div>
					</div>

					<div class="mt-8 hidden gap-2 lg:flex">
						{youth && <span class="tag tag-youth">Youth</span>}
						<span class={`tag tag-${tag.toLowerCase()}`}>{tag}</span>
					</div>
					<h1 class="story-title display mt-5 text-[clamp(1.6rem,2.4vw,2.25rem)]">{title}</h1>
				</div>

				<!-- Photo 1, with an inverted (cut-out) corner holding the date and place -->
				<figure>
					<div class="photo-notch">
						<Image
							src={image}
							alt={alt || title}
							widths={[480, 720, 960, 1200]}
							sizes="(min-width: 1024px) 33rem, 92vw"
							loading="eager"
							fetchpriority="high"
							class="photo block aspect-[4/3] h-auto w-full object-cover"
						/>
						<div class="notch">
							<span class="notch-row">
								<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
									<rect x="3.5" y="5" width="17" height="15.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"></rect>
									<path d="M3.5 10h17M8 3v4M16 3v4" fill="none" stroke="currentColor" stroke-width="1.8"></path>
								</svg>
								<time datetime={date.toISOString().slice(0, 10)}>{published}</time>
							</span>
							<span class="notch-row">
								<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
									<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" fill="none" stroke="currentColor" stroke-width="1.8"></path>
									<circle cx="12" cy="10" r="2.3" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
								</svg>
								{place}
							</span>
						</div>
					</div>
				</figure>
			</div>
		</header>

		<article class="story-wrap story-article">
			<!-- Story text with up to 4 extra photos, alternating left and right -->
			<div class="story-body">
				{
					blocks.map((b, i) => (
						<>
							<Fragment set:html={b.html} />
							{(after.get(i) ?? []).map((ph) => (
								<figure class:list={["story-photo", `size-${ph.size}`, `side-${ph.side}`]}>
									<Image
										src={ph.image}
										alt={photoAlt(ph.n)}
										widths={[480, 720, 960, 1400]}
										sizes={ph.size === "full" ? "(min-width: 1024px) 66rem, 92vw" : "(min-width: 1024px) 30rem, 92vw"}
										class="block h-auto w-full object-cover"
									/>
								</figure>
							))}
						</>
					))
				}
			</div>

			{source && (
				<aside class="source">
					<p>
						First published on dtirapid.ph on {published} by {author}, {unit}.
					</p>
					<a href={source} target="_blank" rel="noopener" class="font-semibold text-teal underline decoration-leaf decoration-2 underline-offset-[6px] hover:decoration-teal">
						Read the original article on dtirapid.ph
					</a>
				</aside>
			)}
		</article>

		<nav class="more" aria-label="More featured stories">
			<div class="shell py-20 sm:py-24">
				<div class="flex flex-wrap items-end justify-between gap-6">
					<h2 class="display text-[clamp(1.8rem,3.4vw,2.6rem)] text-teal">More featured stories</h2>
					<a href="/#featured" class="font-semibold text-teal underline decoration-leaf decoration-2 underline-offset-[6px] hover:decoration-teal">
						Back to the featured wall
					</a>
				</div>
				<ul class="mt-12 grid gap-x-10 gap-y-9 md:grid-cols-2 xl:grid-cols-3">
					{
						others.map((s) => (
							<li>
								<a href={storyHref(s)} class="neighbour group grid grid-cols-[7.5rem_1fr] items-center gap-5 sm:grid-cols-[9rem_1fr]">
									<span class="mini-frame">
										<Image src={s.data.image} alt="" width={320} class="aspect-[4/3] w-full object-cover" />
									</span>
									<span>
										<span class="flex flex-wrap items-center gap-2 text-sm text-ink/60">
											{s.data.youth && <span class="tag tag-youth">Youth</span>}
											<span class={`tag tag-${s.data.tag.toLowerCase()}`}>{s.data.tag}</span>
											<span>{formatDate(s.data.date)}</span>
										</span>
										<span class="neighbour-title mt-2 block leading-snug font-semibold text-teal">{s.data.title}</span>
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</nav>
	</main>
	<Footer />
</Layout>

<style>
	/* Solid band so the photo's cut-out corner blends in; soft light only at the top-left */
	.story-head {
		background:
			radial-gradient(60% 70% at 0% 0%, #0b3a3f 0%, transparent 70%),
			var(--color-canopy);
	}
	.story-title {
		font-stretch: 100%;
		letter-spacing: -0.015em;
		line-height: 1.12;
		text-wrap: balance;
	}
	.tag {
		padding: 0.15rem 0.65rem;
		border-radius: 4px;
		font-size: 0.85rem;
		font-weight: 700;
		background: var(--color-teal-soft);
		color: var(--color-mist);
	}
	.tag-story {
		background: var(--color-leaf);
	}
	.tag-youth {
		background: var(--color-gold);
		color: var(--color-canopy-deep);
	}

	/* Inverted corner: the band colour cuts into the photo's bottom-right corner */
	.photo-notch {
		position: relative;
		--r: 10px;
		--band: var(--color-canopy);
	}
	.photo-notch .photo {
		border-radius: var(--r);
	}
	.notch {
		position: absolute;
		right: 0;
		bottom: 0;
		display: grid;
		gap: 0.3rem;
		padding: 0.85rem 0 0 1.1rem;
		background: var(--band);
		border-top-left-radius: var(--r);
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-mist);
	}
	/* the two concave fillets that make the cut-out look inverted */
	.notch::before,
	.notch::after {
		content: '';
		position: absolute;
		width: var(--r);
		height: var(--r);
		background: radial-gradient(circle at 0 0, transparent calc(var(--r) - 0.5px), var(--band) var(--r));
	}
	.notch::before {
		right: 0;
		bottom: 100%;
	}
	.notch::after {
		right: 100%;
		bottom: 0;
	}
	.notch-row {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		white-space: nowrap;
	}
	.notch-row svg {
		color: var(--color-gold);
		flex: none;
	}

	/* Shared width for the title band and the story, so the photo lines up with both */
	.story-wrap {
		width: 100%;
		max-width: 70rem;
		margin-inline: auto;
		padding-inline: 1rem;
	}
	@media (min-width: 640px) {
		.story-wrap {
			padding-inline: 2rem;
		}
	}

	/* Plain photos: soft corners and shadow, no frame */
	/* Story text wraps around both photos */
	.story-article {
		padding-top: clamp(3rem, 6vw, 4.5rem);
	}
	.story-article::after {
		content: '';
		display: block;
		clear: both;
	}
	.story-body {
		font-size: 1.125rem;
		line-height: 1.75;
		color: rgb(14 35 38 / 0.9);
	}
	.story-body :global(p) {
		margin-top: 1.25em;
	}
	.story-body > :global(:first-child) {
		margin-top: 0;
	}
	.story-body :global(strong) {
		font-weight: 700;
		color: var(--color-ink);
	}
	.story-body :global(ul),
	.story-body :global(ol) {
		margin-top: 1.25em;
		padding-left: 1.4em;
	}
	.story-body :global(ul) {
		list-style: none;
		padding-left: 0;
	}
	.story-body :global(ul > li) {
		position: relative;
		padding-left: 1.5em;
	}
	.story-body :global(ul > li + li),
	.story-body :global(ol > li + li) {
		margin-top: 0.75em;
	}
	.story-body :global(ul > li::before) {
		content: '';
		position: absolute;
		left: 0.2em;
		top: 0.68em;
		width: 0.45em;
		height: 0.45em;
		border-radius: 50%;
		background: var(--color-leaf);
	}
	.story-body :global(ol) {
		list-style: decimal;
	}
	/* Photos typed into the story text are not shown: photos come from the photo fields */
	.story-body :global(p:has(> img)) {
		display: none;
	}
	/* Subheadings (a bold line on its own in the editor) */
	.story-body :global(h3) {
		margin-top: 2em;
		font-size: 1.2rem;
		font-weight: 700;
		line-height: 1.35;
		color: var(--color-teal);
	}
	.story-body :global(blockquote) {
		margin-top: 1.25em;
		padding-left: 1.1em;
		border-left: 3px solid var(--color-leaf);
		font-style: italic;
	}
	.story-body :global(a) {
		color: var(--color-teal);
		text-decoration: underline;
		text-decoration-color: var(--color-leaf);
		text-underline-offset: 3px;
	}

	/* Extra photos: alternate left / right, sized by the editor */
	.story-photo {
		margin: 2rem 0;
	}
	.story-photo :global(img) {
		aspect-ratio: 4 / 3;
		border-radius: 8px;
		box-shadow: 0 24px 40px -24px rgb(3 26 29 / 0.55);
	}
	.story-photo.size-full :global(img) {
		aspect-ratio: 16 / 9;
	}
	@media (min-width: 1024px) {
		.story-photo.side-left {
			float: left;
			clear: left;
			margin: 0.4rem 2.75rem 1.5rem 0;
		}
		.story-photo.side-right {
			float: right;
			clear: right;
			margin: 0.4rem 0 1.5rem 2.75rem;
		}
		.story-photo.size-small {
			width: 30%;
		}
		.story-photo.size-medium {
			width: 40%;
		}
		.story-photo.size-large {
			width: 52%;
		}
		.story-photo.size-full {
			float: none;
			clear: both;
			width: 100%;
			margin: 2.5rem 0;
		}
	}

	.source {
		clear: both;
		margin-top: 3.5rem;
		padding-top: 1.75rem;
		border-top: 1px solid rgb(0 68 80 / 0.15);
		color: rgb(14 35 38 / 0.7);
	}
	.source a {
		display: inline-block;
		margin-top: 0.75rem;
	}

	.more {
		margin-top: clamp(4rem, 9vw, 7rem);
		background: color-mix(in oklab, var(--color-mist-deep) 60%, var(--color-mist));
	}
	.mini-frame {
		display: block;
		padding: 5px;
		background: linear-gradient(145deg, #3a2a1f, #1f150f);
		border-radius: 2px;
	}
	.neighbour-title {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.neighbour:hover .neighbour-title,
	.neighbour:focus-visible .neighbour-title {
		text-decoration: underline;
		text-decoration-color: var(--color-leaf);
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
	}
</style>
