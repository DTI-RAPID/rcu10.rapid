---
import { Image } from "astro:assets";
import { render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { storyHref, formatDate, type Story } from "../lib/stories";

interface Props {
  story: Story;
  others: Story[];
}

const { story, others } = Astro.props;
const {
  title,
  tag,
  youth,
  date,
  place,
  summary,
  image,
  alt,
  caption,
  author,
  unit,
  source,
} = story.data;
const { Content } = await render(story);
const published = formatDate(date);
---

<Layout title={`${title} | RAPID Growth Region 10`} description={summary}>
	<Nav />
	<main>
		<header class="story-head text-mist">
			<div class="shell grid items-center gap-8 pb-12 pt-24 sm:gap-12 sm:pt-36 lg:grid-cols-[1.1fr_1fr] lg:gap-16 lg:pb-20">
				<div>
					<div class="flex flex-wrap items-center justify-between gap-3">
						<a href="/#featured" class="back inline-flex items-center gap-2 text-sm font-semibold text-mist/75 hover:text-mist">
							<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
								<path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2"></path>
							</svg>
							Featured stories
						</a>
						<div class="flex gap-2 lg:hidden">
							{youth && <span class="tag tag-youth">Youth</span>}
							<span class={`tag tag-${tag.toLowerCase()}`}>{tag}</span>
						</div>
					</div>

					<div class="mt-8 hidden gap-2 lg:flex">
						{youth && <span class="tag tag-youth">Youth</span>}
						<span class={`tag tag-${tag.toLowerCase()}`}>{tag}</span>
					</div>
					<h1 class="story-title display mt-5 text-[clamp(1.65rem,3.3vw,2.9rem)]">{title}</h1>

					<!-- Date and place on one line -->
					<p class="meta mt-5 flex flex-wrap gap-x-6 gap-y-2 text-mist/80 sm:mt-7">
						<span class="inline-flex items-center gap-2">
							<svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
								<rect x="3.5" y="5" width="17" height="15.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"></rect>
								<path d="M3.5 10h17M8 3v4M16 3v4" fill="none" stroke="currentColor" stroke-width="1.8"></path>
							</svg>
							<time datetime={date.toISOString().slice(0, 10)}>{published}</time>
						</span>
						<span class="inline-flex items-center gap-2">
							<svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
								<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" fill="none" stroke="currentColor" stroke-width="1.8"></path>
								<circle cx="12" cy="10" r="2.3" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
							</svg>
							{place}
						</span>
					</p>
				</div>

				<!-- The photo hangs in the same frame as on the museum wall -->
				<figure>
					<div class="hero-frame">
						<div class="hero-mat">
							<Image
								src={image}
								alt={alt}
								widths={[640, 960, 1280]}
								sizes="(min-width: 1024px) 34rem, 92vw"
								loading="eager"
								fetchpriority="high"
								class="block aspect-[4/3] h-auto w-full object-cover"
							/>
						</div>
					</div>
					{caption && <figcaption class="hero-caption">{caption}</figcaption>}
				</figure>
			</div>
		</header>

		<article class="shell">
			<div class="story-body">
				<Content />
			</div>

			{source && (
			<aside class="source">
					<p>
						First published on dtirapid.ph on {published} by {author}, {unit}.
					</p>
					<a href={source} target="_blank" rel="noopener" class="font-semibold text-teal underline decoration-leaf decoration-2 underline-offset-[6px] hover:decoration-teal">
						Read the original article on dtirapid.ph
					</a>
				</aside>
			)}
		</article>

		<nav class="more" aria-label="More featured stories">
			<div class="shell py-20 sm:py-24">
				<div class="flex flex-wrap items-end justify-between gap-6">
					<h2 class="display text-[clamp(1.8rem,3.4vw,2.6rem)] text-teal">More featured stories</h2>
					<a href="/#featured" class="font-semibold text-teal underline decoration-leaf decoration-2 underline-offset-[6px] hover:decoration-teal">
						Back to the featured wall
					</a>
				</div>
				<ul class="mt-12 grid gap-x-10 gap-y-9 md:grid-cols-2 xl:grid-cols-3">
					{
						others.map((s) => (
							<li>
								<a href={storyHref(s)} class="neighbour group grid grid-cols-[7.5rem_1fr] items-center gap-5 sm:grid-cols-[9rem_1fr]">
									<span class="mini-frame">
										<Image src={s.data.image} alt="" width={320} class="aspect-[4/3] w-full object-cover" />
									</span>
									<span>
										<span class="flex flex-wrap items-center gap-2 text-sm text-ink/60">
											{s.data.youth && <span class="tag tag-youth">Youth</span>}
											<span class={`tag tag-${s.data.tag.toLowerCase()}`}>{s.data.tag}</span>
											<span>{formatDate(s.data.date)}</span>
										</span>
										<span class="neighbour-title mt-2 block leading-snug font-semibold text-teal">{s.data.title}</span>
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</nav>
	</main>
	<Footer />
</Layout>

<style>
	.story-head {
		background:
			radial-gradient(70% 80% at 70% 0%, #0d3c41 0%, transparent 70%),
			linear-gradient(#031a1d, #062b2f);
	}
	.story-title {
		font-stretch: 104%;
		line-height: 1.06;
		text-wrap: balance;
	}
	.tag {
		padding: 0.15rem 0.65rem;
		border-radius: 999px;
		font-size: 0.85rem;
		font-weight: 700;
		background: var(--color-teal-soft);
		color: var(--color-mist);
	}
	.tag-story {
		background: var(--color-leaf);
	}
	.tag-youth {
		background: var(--color-gold);
		color: var(--color-canopy-deep);
	}

	.meta {
		font-size: 0.975rem;
	}
	.meta svg {
		color: var(--color-gold);
	}

	/* Same wood frame and mat as the museum wall */
	.hero-frame {
		padding: clamp(8px, 1vw, 12px);
		background: linear-gradient(145deg, #3a2a1f, #1f150f);
		border-radius: 3px;
		box-shadow:
			inset 0 0 0 1px rgb(255 255 255 / 0.08),
			0 40px 60px -35px rgb(0 0 0 / 0.8);
	}
	.hero-mat {
		padding: clamp(8px, 1.8vw, 22px);
		background: #eef2ee;
		box-shadow: inset 0 2px 6px rgb(0 0 0 / 0.25);
	}
	.hero-caption {
		margin-top: 0.9rem;
		font-size: 0.875rem;
		line-height: 1.5;
		color: rgb(233 239 234 / 0.6);
	}

	/* Reading column */
	.story-body {
		max-width: 62rem;
		margin: clamp(3rem, 6vw, 4.5rem) auto 0;
		font-size: 1.125rem;
		line-height: 1.75;
		color: rgb(14 35 38 / 0.9);
	}
	.story-body :global(p) {
		margin-top: 1.25em;
	}
	.story-body :global(> p:first-child) {
		margin-top: 0;
		font-size: 1.28rem;
		line-height: 1.6;
		color: var(--color-ink);
	}
	.story-body :global(strong) {
		font-weight: 700;
		color: var(--color-ink);
	}
	.story-body :global(ul),
	.story-body :global(ol) {
		margin-top: 1.25em;
		padding-left: 1.4em;
	}
	.story-body :global(ul) {
		list-style: none;
		padding-left: 0;
	}
	.story-body :global(ul > li) {
		position: relative;
		padding-left: 1.5em;
	}
	.story-body :global(ul > li + li),
	.story-body :global(ol > li + li) {
		margin-top: 0.75em;
	}
	.story-body :global(ul > li::before) {
		content: '';
		position: absolute;
		left: 0.2em;
		top: 0.68em;
		width: 0.45em;
		height: 0.45em;
		border-radius: 50%;
		background: var(--color-leaf);
	}
	.story-body :global(ol) {
		list-style: decimal;
	}
	/* In-article photos sit a little wider than the text column */
	.story-body :global(img) {
		display: block;
		width: 100%;
		height: auto;
		margin-top: 2.25rem;
		margin-bottom: 0.75rem;
		border-radius: 4px;
	}
	@media (min-width: 1024px) {
		.story-body :global(p:has(> img)) {
			margin-inline: -5rem;
		}
	}

	.source {
		max-width: 62rem;
		margin: 3.5rem auto 0;
		padding-top: 1.75rem;
		border-top: 1px solid rgb(0 68 80 / 0.15);
		color: rgb(14 35 38 / 0.7);
	}
	.source a {
		display: inline-block;
		margin-top: 0.75rem;
	}

	.more {
		margin-top: clamp(4rem, 9vw, 7rem);
		background: color-mix(in oklab, var(--color-mist-deep) 60%, var(--color-mist));
	}
	.mini-frame {
		display: block;
		padding: 5px;
		background: linear-gradient(145deg, #3a2a1f, #1f150f);
		border-radius: 2px;
	}
	.neighbour-title {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.neighbour:hover .neighbour-title,
	.neighbour:focus-visible .neighbour-title {
		text-decoration: underline;
		text-decoration-color: var(--color-leaf);
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
	}
</style>
